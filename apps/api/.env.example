# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PocketBase (existing)
POCKETBASE_URL=http://localhost:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# n8n webhooks (existing — do not remove)
N8N_CHAT_WEBHOOK=
N8N_CHAT_API_KEY=
N8N_WEBHOOK_URL=
N8N_GET_USER_WEBHOOK=
N8N_GET_THREAD_WEBHOOK=
N8N_SAVE_MESSAGE_WEBHOOK=

# Supabase — backend only (never expose service role to the browser)
# Use a dedicated STAGING project for P0 harness — never assume production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# P0 staging harness — explicit opt-in (see tests/agent-session-p0-staging.README.md)
RUN_STAGING=false
STAGING_ALLOWED_SUPABASE_PROJECT_REF=

# F4-B1 — atomic pending confirmation + business write (staging first)
AGENT_SESSION_TRANSACTIONAL_CONFIRM=false

# F4-B2-C/D — durable idempotency + Node replay (requires transactional confirm)
AGENT_SESSION_IDEMPOTENT_CONFIRM=false

# Protects GET /api/supabase/status (header: x-ash-internal-key)
ASH_INTERNAL_HEALTH_KEY=

# Ashy LLM intent resolver (Phase 3.3)
ASHY_LLM_ENABLED=false
OPENAI_API_KEY=
ASHY_LLM_MODEL=gpt-4o-mini
ASHY_LLM_BASE_URL=https://api.openai.com/v1
ASHY_LLM_TIMEOUT_MS=8000

# Business calendar timezone for period filters (IANA name)
ASH_LEDGER_TIMEZONE=Africa/Kinshasa
