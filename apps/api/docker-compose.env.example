# Copy to .env next to docker-compose.yml on the VPS. Never commit real values.
#
# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=

# PocketBase — host gateway from Docker (adjust if using host network)
POCKETBASE_URL=http://172.17.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# n8n webhooks (chat proxy + thread persistence)
N8N_CHAT_WEBHOOK=
N8N_CHAT_API_KEY=
N8N_WEBHOOK_URL=
N8N_GET_USER_WEBHOOK=
N8N_GET_THREAD_WEBHOOK=
N8N_SAVE_MESSAGE_WEBHOOK=

# Supabase — backend only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Internal health probe for GET /api/supabase/status
ASH_INTERNAL_HEALTH_KEY=

# Ashy LLM (optional)
ASHY_LLM_ENABLED=false
OPENAI_API_KEY=
ASHY_LLM_MODEL=gpt-4o-mini
ASHY_LLM_BASE_URL=https://api.openai.com/v1
ASHY_LLM_TIMEOUT_MS=8000

# Business timezone
ASH_LEDGER_TIMEZONE=Africa/Kinshasa

# Traefik labels (optional — only if exposing API directly via HTTPS)
API_HOST=
COMPOSE_PROJECT_NAME=ash-ledger-api
