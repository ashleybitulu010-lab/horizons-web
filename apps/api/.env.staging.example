# Ash Ledger — Supabase STAGING only (local, never commit real values)
# Copy to .env.staging (gitignored) after creating a dedicated Supabase staging project.
# NEVER use production project knrwplidgvuvjnuqqmrt here.

SUPABASE_URL=https://{STAGING_PROJECT_REF}.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<STAGING_SERVICE_ROLE_KEY>

# Pooler host (Dashboard → Database → Connection string → Session pooler)
# Example for Ash Ledger Staging: aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432

# P0 staging harness — required for real Supabase integration tests
RUN_STAGING=true
STAGING_ALLOWED_SUPABASE_PROJECT_REF={STAGING_PROJECT_REF}
NODE_ENV=development

# Optional — same n8n keys as dev if orchestrator tests need webhooks
# N8N_CHAT_WEBHOOK=
# N8N_CHAT_API_KEY=

# Phase 5.8-F2 — require DB pending before NEEDS_CONFIRMATION (staging validation)
# AGENT_SESSION_PENDING_DB_REQUIRED=true

# Phase 5.8-F3 — DB-first writer (staging validation)
# AGENT_SESSION_WRITE_DB_FIRST=true
# AGENT_SESSION_RAM_FALLBACK=true
# AGENT_SESSION_MIRROR_AWAIT=true
