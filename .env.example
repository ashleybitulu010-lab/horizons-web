# Ash Ledger web — environment variables (Vite)

# Phase 3.7: route read-only chat intents to /api/ashy/chat instead of n8n.
# Default OFF — set to "true" only for controlled testing.
# On Ashy HTTP/network failure, reads automatically fall back to n8n.
VITE_ASHY_READ_CHAT=false

# H12.1: SALES read migration to V2 (default ON). Rollback: set to "false".
VITE_ASHY_READ_SALES=true

# H12.2: EXPENSES read migration to V2 (default OFF). Enable: set to "true".
VITE_ASHY_READ_EXPENSES=false

# H12.3: STOCK read migration to V2 (default OFF). Enable: set to "true".
VITE_ASHY_READ_STOCK=false
